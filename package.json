{
	"name": "n8n-nodes-firmledger",
	"version": "0.1.11",
	"description": "Search and verify businesses on FirmLedger from n8n workflows.",
	"license": "MIT",
	"homepage": "https://firmledger.co.ke",
	"keywords": [
		"n8n-community-node-package",
		"firmledger",
		"business-directory",
		"mcp"
	],
	"author": {
		"name": "FirmLedger",
		"email": "support@firmledger.co.ke"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firmledger-ke/n8n-nodes-firmledger.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist",
		"icons"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FirmLedgerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FirmLedger/FirmLedger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
